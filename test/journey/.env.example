# Copy to .env (never commit it) or set these as pipeline variables.
# Only non-secret values belong here; credentials belong in a secret store.

# --- Target -----------------------------------------------------------------
PROFICIENCY_TESTING_WEB_URL=http://localhost:1946
PROFICIENCY_TESTING_EXTERNAL_WEB_URL=http://localhost:1688
PROFICIENCY_TESTING_WEB_SERVICES_URL=http://localhost:1935

# legacy | gds. Validated at import: a typo fails the run instead of falling back.
UI_PROFILE=legacy

# --- Roles for the auth setup -------------------------------------------------
# Comma-separated. Each role gets .auth/<role>.json and a project in playwright.config.js.
E2E_ROLES=applicant

# --- Credentials (secrets: set in ADO as secret variables, mapped in the YAML) ---
E2E_APPLICANT_USER=
E2E_APPLICANT_PASSWORD=
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# --- Accessibility -------------------------------------------------------------
A11Y_SCAN=true
A11Y_DIR=reports/a11y
# Fail on violations that are not in docs/a11y-baseline.json (recommended in CI for legacy).
# Fail on violations not recorded in docs/a11y-baseline.json. Leave true: the standard is zero
# violations, and a legacy backlog is recorded once with `node scripts/a11y-baseline.js --update`.
A11Y_FAIL_ON_NEW=false
# Query parameters that select a different view, e.g. tab,step
A11Y_KEEP_PARAMS=

# --- Reporting -----------------------------------------------------------------
PLAYWRIGHT_JUNIT_OUTPUT_FILE=reports/junit/results.xml
