# Internal app (PTL.InternalWeb, Entra ID sign-in). Used by the `internal` project.
PROFICIENCY_TESTING_WEB_URL=https://vetqas-internal-tst.aws-int.defra.cloud

# Parked: external app automation.
PROFICIENCY_TESTING_EXTERNAL_WEB_URL=

UI_PROFILE=gds

E2E_ROLES=applicant

# Entra ID test account for the internal app. Set in .env or as secret pipeline variables; never commit values.
INTERNAL_WEB_APPLICANT_USER=
INTERNAL_WEB_APPLICANT_PASSWORD=

EXTERNAL_WEB_APPLICANT_USER=
EXTERNAL_WEB_APPLICANT_PASSWORD=

# --- Accessibility -------------------------------------------------------------
A11Y_SCAN=true
A11Y_DIR=reports/a11y
A11Y_FAIL_ON_NEW=false
A11Y_KEEP_PARAMS=

PLAYWRIGHT_JUNIT_OUTPUT_FILE=reports/junit/results.xml
